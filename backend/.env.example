DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/v2_enterprise?schema=public"
JWT_SECRET="your-super-secret-jwt-key-here-change-this"
JWT_EXPIRES_IN="7d"
PORT=5000
NODE_ENV="development"
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
ADMIN_SECRET_CODE="v2admin2025"
FRONTEND_URL="http://localhost:5173"

# Cloudflare R2 Settings
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="v2-enterprise"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"
# Shopping assistant (chat widget). Off unless CHAT_ENABLED=true and the provider's key is set.
CHAT_ENABLED="false"
# gemini (default model gemini-3.5-flash-lite), bedrock-mantle (zai.glm-5) or anthropic (claude-haiku-5-5)
CHAT_PROVIDER="gemini"
# Optional model override. Gemini 2.5 Flash-Lite is restricted for new API users;
# use the default Gemini 3.5 Flash-Lite or an available current model instead.
CHAT_MODEL=""
# Google AI Studio API key (only when CHAT_PROVIDER=gemini)
GEMINI_API_KEY=""
# Only when CHAT_PROVIDER=bedrock-mantle: Amazon Bedrock long-term API key (Bedrock console > API keys) and the region with model access
AWS_BEARER_TOKEN_BEDROCK=""
BEDROCK_REGION="us-east-1"
# Only needed when CHAT_PROVIDER=anthropic
ANTHROPIC_API_KEY=""
# Hard cap on estimated model spend per UTC day (USD). The assistant pauses once reached.
CHAT_DAILY_BUDGET_USD="5"
