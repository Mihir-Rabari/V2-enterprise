DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/v2_enterprise?schema=public"
JWT_SECRET="your-super-secret-jwt-key-here-change-this"
JWT_EXPIRES_IN="7d"
PORT=5000
NODE_ENV="development"
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
ADMIN_SECRET_CODE="v2admin2025"
FRONTEND_URL="http://localhost:5173"

# Cloudflare R2 Settings
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="v2-enterprise"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"
# Shopping assistant (chat widget). Off unless CHAT_ENABLED=true and the provider's key is set.
CHAT_ENABLED="false"
# bedrock-mantle uses Amazon Bedrock's OpenAI-compatible Chat Completions API (zai.glm-5).
# gemini (gemini-3.8-flash) and anthropic (claude-haiku-5-5) are also supported.
CHAT_PROVIDER="bedrock-mantle"
# Optional model override; defaults to zai.glm-5 for Bedrock.
CHAT_MODEL="zai.glm-5"
# Google AI Studio API key (only when CHAT_PROVIDER=gemini)
GEMINI_API_KEY=""
# Only when CHAT_PROVIDER=bedrock-mantle: Amazon Bedrock API key (keep it secret) and the region with model access
AWS_BEARER_TOKEN_BEDROCK=""
BEDROCK_REGION="ap-south-1"
# Only needed when CHAT_PROVIDER=anthropic
ANTHROPIC_API_KEY=""
# Hard cap on estimated model spend per UTC day (USD). The assistant pauses once reached.
CHAT_DAILY_BUDGET_USD="5"
