# Base URL of the Express backend API the Next.js app talks to.
# Local development (backend on :5000):
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# Production (Express serves frontend + API from one origin): leave unset
# and the client falls back to the relative path /api/v1.

# Set to 'true' ONLY for local development to serve mock API responses.
# Mock mode is additionally gated to localhost/192.168.* hosts, so it can
# never activate in production even if accidentally set.
NEXT_PUBLIC_USE_MOCK_API=false

# Canonical origin of this Next.js app (used for SEO/metadata purposes).
NEXT_PUBLIC_SITE_URL=http://localhost:3001
