// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

enum Status {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  DELIVERED
  CANCELLED
  REFUNDED
}

enum ReviewStatus {
  ACTIVE
  INACTIVE
}

enum ContactStatus {
  UNREAD
  READ
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  phone     String?
  role      Role      @default(CUSTOMER)
  addresses Address[]
  orders    Order[]
  reviews   Review[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}

model Address {
  id        Int     @id @default(autoincrement())
  label     String  // e.g. 'Home', 'Office'
  street    String
  city      String
  state     String
  zipCode   String
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@map("addresses")
}

model Product {
  id            Int         @id @default(autoincrement())
  name          String
  price         Float
  originalPrice Float?
  discount      String?
  photo         String
  hoverImage    String?
  mainCategory  String
  subCategory   String
  description   String
  sizes         String[]
  colors        String[]
  isNew         Boolean     @default(false)
  isTrending    Boolean     @default(false)
  tags          String[]
  status        Status      @default(ACTIVE)
  orderItems    OrderItem[]
  reviews       Review[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("products")
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  image       String?
  description String?
  status      Status     @default(ACTIVE)
  parentId    Int?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")

  @@map("categories")
}

model Order {
  id          Int         @id @default(autoincrement())
  orderId     String      @unique
  user        User        @relation(fields: [userId], references: [id])
  userId      String
  items       OrderItem[]
  total       Float
  method      String      // 'cod' | 'prepaid' | 'pickup'
  status      OrderStatus @default(PENDING)
  address     String      // JSON string snapshot of shipping address
  phone       String
  waybill     String?
  couponCode  String?
  discount    Float       @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("orders")
}

model OrderItem {
  id           Int     @id @default(autoincrement())
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      Int
  product      Product @relation(fields: [productId], references: [id])
  productId    Int
  productName  String  // snapshot
  productPhoto String  // snapshot
  quantity     Int
  size         String?
  color        String?
  priceAtTime  Float   // snapshot — immutable record of what they paid

  @@map("order_items")
}

model Review {
  id              Int          @id @default(autoincrement())
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId       Int
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId          String?
  customerName    String
  customerEmail   String
  rating          Int
  reviewText      String
  status          ReviewStatus @default(INACTIVE)
  homepageVisible Boolean      @default(false)
  date            DateTime     @default(now())

  @@map("reviews")
}

model Coupon {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  discountType  String   // 'percentage' | 'fixed'
  discountValue Float
  minOrderValue Float    @default(0)
  isActive      Boolean  @default(true)
  expiresAt     DateTime?
  createdAt     DateTime @default(now())

  @@map("coupons")
}

model SiteSettings {
  id           String @id @default("global_settings")
  logoText     String @default("V2")
  logoSubtext  String @default("Fashion Hub")
  slogan       String @default("A Smart Fashion Hub")
  email        String @default("hello@v2fashion.com")
  phone        String @default("+91 90338 83395")
  address      String @default("")
  instagram    String @default("")
  twitter      String @default("")
  facebook     String @default("")
  youtube      String @default("")
  copyright    String @default("© 2025 V2Fashion. All rights reserved.")
  storeHours   String @default("Mon - Sat: 10:00 AM - 09:00 PM\nSun: 10:00 AM - 07:00 PM")
  gridSettings Json   @default("{\"mobile\":2,\"tablet\":2,\"desktop\":4}")
  updatedAt    DateTime @updatedAt

  @@map("site_settings")
}

model Slider {
  id     Int    @id @default(autoincrement())
  image  String
  title  String
  link   String @default("/shop")
  status Status @default(ACTIVE)

  @@map("sliders")
}

model HeroSlide {
  id          Int      @id @default(autoincrement())
  type        String   @default("image") // 'image' | 'video'
  url         String
  tagline     String
  title       String
  description String
  ctaText     String
  ctaLink     String   @default("/shop")
  duration    Int?
  order       Int      @default(0)
  status      Status   @default(ACTIVE)

  @@map("hero_slides")
}

model ContactMessage {
  id      Int           @id @default(autoincrement())
  name    String
  email   String
  message String
  status  ContactStatus @default(UNREAD)
  date    DateTime      @default(now())

  @@map("contact_messages")
}

model JournalPost {
  id       Int      @id @default(autoincrement())
  title    String
  category String
  image    String
  excerpt  String
  date     DateTime @default(now())
  status   Status   @default(ACTIVE)

  @@map("journal_posts")
}
